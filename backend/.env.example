# 你的合规中转 API 地址（大陆或海外线路），留空则直连 Anthropic
ANTHROPIC_BASE_URL=https://your-relay.example.com
# 中转方发放的密钥
ANTHROPIC_API_KEY=
# 模型名，以中转方提供的名称为准
MODEL=claude-opus-5-5
# 推理强度：low | medium | high，聊天场景用 low 保证速度
EFFORT=low
# 中转不支持服务端 fallback 时改为 false
ENABLE_SERVER_FALLBACK=true
# 每个设备每天的免费生成次数
DAILY_FREE_QUOTA=20
# Postgres 连接串，存用户、订阅和每日额度；留空则存在内存里，重启会丢
DATABASE_URL=
PORT=8787
# 登录用户（已订阅）每天的生成次数
SUBSCRIBER_DAILY_QUOTA=300
# 会话签名密钥，至少 32 个字符，可用 `openssl rand -hex 32` 生成；留空则关闭 Apple 登录
SESSION_SECRET=
# 与 iOS App 的 Bundle ID 一致
APPLE_BUNDLE_ID=com.example.eqkeyboard.EQKeyboard
# App Store Connect 里的 App 数字 ID（Production 环境必填）
APP_APPLE_ID=
# Sandbox 或 Production
APPSTORE_ENVIRONMENT=Sandbox
# Apple 根证书路径，逗号分隔，从 https://www.apple.com/certificateauthority/ 下载 AppleRootCA-G3.cer；留空则关闭订阅校验
APPLE_ROOT_CERT_PATHS=
# 订阅商品 ID，需与 App Store Connect 一致
SUBSCRIPTION_PRODUCT_IDS=eqkeyboard.pro.monthly,eqkeyboard.pro.yearly
